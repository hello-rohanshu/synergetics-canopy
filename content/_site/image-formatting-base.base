views:
  - type: table
    name: View 2
    filters:
      and:
        - file.folder == "Illustrations/Attachments"
        - file.backlinks.filter(!value.asFile().inFolder("Illustrations/Tables and Figures"))
    order:
      - file.name
      - file.backlinks
    sort: []
  - type: table
    name: View
    filters:
      and:
        - file.folder == "Illustrations/Tables and Figures"
    order:
      - file.name
      - file.embeds
